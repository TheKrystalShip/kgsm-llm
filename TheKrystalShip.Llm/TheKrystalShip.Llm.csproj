<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>TheKrystalShip.Llm</PackageId>
    <Authors>Heisenberg</Authors>
    <Version>1.6.0</Version>
    <PackageProjectUrl>https://github.com/TheKrystalShip/TheKrystalShip.Llm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheKrystalShip/TheKrystalShip.Llm</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <Description>Reusable client and tool-calling agent loop for a local LLM (Ollama). Transport-agnostic DTOs, conversation memory, and a host-driven agent loop that any C# app can reuse.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>TheKrystalShip.Llm</RootNamespace>
    <AssemblyName>TheKrystalShip.Llm</AssemblyName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Don't require XML docs on every public member (e.g. Result properties). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Expose internals (e.g. the Ollama tool-payload builder) to the test project only;
       `internal` keeps them out of the published package's public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TheKrystalShip.Llm.Tests" />
  </ItemGroup>

  <!--
    Floor the framework-extension deps at 8.0.0 (the lowest that supports the
    APIs used here) so the package is consumable by both .NET 8.x and 9.x hosts
    without forcing a package upgrade/downgrade on the consumer.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Durable conversation memory (SqliteConversationStore). Pinned to the same 10.0.5 native SQLite
         the kgsm-api uses — one bundle version across the ecosystem. Consumed only by JIT hosts (the
         Service/CLI); the AOT RAG indexer references TheKrystalShip.Rag, not this library, so it stays
         SQLite-free. The transitive SQLitePCLRaw advisory is suppressed repo-wide in Directory.Build.props. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
  </ItemGroup>

</Project>
