<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Kgsm.Assistant.Cli</RootNamespace>
    <!-- The binary on PATH is `kgsm-assistant-cli`, not the dotted project name. -->
    <AssemblyName>kgsm-assistant-cli</AssemblyName>
    <!-- Dev runs (dotnet run) use the installed net10 runtime; the shipped artifact is a
         FRAMEWORK-DEPENDENT single-file publish (the host has the runtime installed), so
         RollForward only helps a dev box that has a newer major than 10. -->
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Embed the app's own symbols into the binary so the single-file publish drops no
         separate kgsm-assistant.pdb (stack traces stay useful). The shipped artifact is the
         one `kgsm-assistant` file; any dependency .pdb/.xml in the publish dir are ignorable. -->
    <DebugType>embedded</DebugType>

    <!-- Framework-dependent single file: publish-only props (build/test ignore them); the RID
         is supplied at publish time (deploy/deploy.sh passes -r linux-x64). Not self-contained —
         the runtime is on the host, which keeps the binary small. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Backend, three calls: AddLocalLlm (Llm) + AddKgsmAssistant (Assistant) +
         AddKgsmAdapters (Infrastructure, the socket-safe seam). No ASP.NET. -->
    <ProjectReference Include="..\TheKrystalShip.Llm\TheKrystalShip.Llm.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant\TheKrystalShip.Kgsm.Assistant.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant.Infrastructure\TheKrystalShip.Kgsm.Assistant.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HostApplicationBuilder (config + DI + logging). The meta-package brings the JSON /
         env-var config providers and the console logger the composition root uses. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single canonical config surface. Embedded as a manifest resource so the lone
         self-contained binary carries its full defaults (it stands on its own legs with zero
         sidecar files), AND copied next to the binary so it ships as a readable, editable
         template the operator can tune. No magic-string defaults live in C# any more — this
         file is the one place the CLI's configurable surface is declared. -->
    <EmbeddedResource Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <LogicalName>kgsm-assistant-cli.appsettings.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Let the test project exercise the arg parser + renderer (both internal). -->
    <InternalsVisibleTo Include="TheKrystalShip.Kgsm.Assistant.Cli.Tests" />
  </ItemGroup>

</Project>
