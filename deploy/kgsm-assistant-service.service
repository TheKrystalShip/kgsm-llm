[Unit]
# KGSM Assistant — HTTP/SSE turn API (framework-dependent single-file .NET 10 app — needs the
# .NET 10 ASP.NET Core shared runtime on the host). Full runbook: ../docs/DEPLOYMENT.md
Description=KGSM Assistant HTTP/SSE service
Documentation=https://github.com/TheKrystalShip/kgsm-llm
# Runtime deps are LAZY (first /turn), not startup — the service boots fine without them.
# If Ollama and/or the kgsm engine run as systemd units on this host, order after them:
After=network-online.target
Wants=network-online.target
# After=ollama.service kgsm-watchdog.service

[Service]
Type=simple
# Run as the user that OWNS the kgsm instance registry (~/.local/share/kgsm): the service
# shells out to kgsm.sh via kgsm-lib, so it must see the same instances that user does.
# Do NOT override XDG_DATA_HOME here — that hides every instance (see DEPLOYMENT.md gotchas).
User=kgsm
Group=kgsm

# WorkingDirectory is the content root — kgsm-assistant.settings.json ships beside the binary and is loaded
# relative to here; without it the service starts with defaults only.
WorkingDirectory=/opt/kgsm-assistant/service
# Framework-dependent single-file binary (deploy.sh publishes it with --no-self-contained).
ExecStart=/opt/kgsm-assistant/service/kgsm-assistant

# Plain HTTP on loopback — terminate TLS at a reverse proxy (nginx) in front. See DEPLOYMENT.md.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5180
# The engine's event journal, which this service tails so a blueprint edited elsewhere (the Control
# Panel, another operator's CLI) invalidates the assistant's blueprint cache at once. Read-only and
# shared — nothing is bound and nothing on the engine side names this reader. Unset, the service
# reads no events and falls back to the cache TTL.
Environment=KGSM__JournalDir=/var/lib/kgsm/events
# The prompt segments and tool definitions the assistant runs on. They are files, not code, and a
# blank value is a fatal startup error naming the file — so the path is declared here rather than
# left to an env file every host would have to remember to set. This names the packaged location;
# deploy.sh rewrites it to the prefix it installs the same files into, and either way a
# Prompts__Directory in an env file below still wins, because systemd reads those last.
Environment=Prompts__Directory=/usr/share/kgsm-assistant/prompts
# Secrets + non-default config live here (chmod 600, root:root or kgsm:kgsm). Template: assistant.env.example
# Who may do what on this host, shared with every other KGSM surface. Loaded FIRST so the per-leaf
# file below can still override a value deliberately; setting one there is how a host ends up
# granting the same person different authority on different surfaces, so prefer the shared file.
# Seeded by deploy/setup.sh; optional, so a host that never provisioned it still starts.
EnvironmentFile=-/etc/kgsm/kgsm-auth.env
EnvironmentFile=/etc/kgsm-assistant/service.env

# systemd creates this owned by the service user; the event socket above is bound inside it.
RuntimeDirectory=kgsm-assistant
RuntimeDirectoryMode=0750
# Keep /run/kgsm-assistant across restarts so systemd never removes it while the service runs.
# Belt to the listener's suspenders: kgsm-lib's UnixSocketClient re-binds if the socket file is
# unlinked, but preserving the directory prevents the systemd-driven removal class outright.
RuntimeDirectoryPreserve=yes

# Persistent state (the conversation database, which also holds the staged actions and the session
# registry) lives in /var/lib/kgsm-assistant. systemd creates the directory before ExecStart owned by
# User= and exports $STATE_DIRECTORY, so provisioning it costs no privilege — the same declaration
# kgsm-api, kgsm-monitor and kgsm-watchdog use. It is independent of User=, which deploy.sh templates
# per host, and of whether that account has a home directory at all. kgsm-rag-indexer.service
# declares the SAME directory: it writes the index this service reads, and both units run as the
# same user, so one declaration on each is what puts them in one place.
StateDirectory=kgsm-assistant
StateDirectoryMode=0750

Restart=on-failure
RestartSec=5

# Journald with the ecosystem's <N> priority prefixes (the app uses AddSystemdConsole()).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kgsm-assistant

# Light hardening. The service shells out to kgsm.sh (which touches the kgsm data dir, the
# watchdog socket, and game-server processes), so do NOT add aggressive ProtectSystem/
# ProtectHome sandboxing without testing a real action end-to-end — it will break kgsm.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
