# ─────────────────────────────────────────────────────────────────────────────
# KGSM Assistant Service — environment file (systemd EnvironmentFile)
#
# Copy to /etc/kgsm-assistant/service.env, fill in the real values, then:
#     sudo chmod 600 /etc/kgsm-assistant/service.env
#     sudo chown kgsm:kgsm /etc/kgsm-assistant/service.env
#
# This file holds SECRETS. They are intentionally NOT in appsettings.json — supply them
# only via the environment. Every key uses the ASP.NET "Section__Key" double-underscore form
# and overrides the matching appsettings.json value. Full reference: ../docs/CONFIGURATION.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Listen address (loopback; TLS terminates at the reverse proxy in front) ──
ASPNETCORE_URLS=http://127.0.0.1:5180

# ── Backends ──────────────────────────────────────────────────────────────
# Ollama (chat model). Embedder endpoint is Rag__Endpoint, below.
Ollama__Endpoint=http://localhost:11434
Ollama__Model=gemma4:12b
# Absolute path to the kgsm engine entrypoint this host manages.
KGSM__Path=/opt/kgsm/kgsm.sh

# ── Discord OAuth (login + per-user authority) ──────────────────────────────
# From the Discord Developer Portal. ClientSecret + BotToken are SECRETS.
# With BotToken unset, ALL logins are denied; with ClientSecret unset, login is denied.
DiscordOAuth__ClientId=
DiscordOAuth__ClientSecret=
DiscordOAuth__BotToken=
DiscordOAuth__GuildId=
# Members with this role may run mutating actions; everyone else is read-only.
DiscordOAuth__ActionRoleId=
# Must exactly match a redirect URI registered in the Developer Portal (your SPA's callback).
DiscordOAuth__RedirectUri=https://panel.example.com/auth/callback

# ── Action authority + confirmation signing ─────────────────────────────────
# Master switch for mutating actions. Leave false until Discord auth is wired and tested.
Assistant__ActionsEnabled=true
# HMAC key that signs confirmation tokens. Generate once and KEEP IT STABLE — if it changes
# (or is empty) pending confirmations are rejected and actions fall back to read-only.
#   openssl rand -base64 48
Assistant__Confirmation__Key=
# Shared secret for the kgsm event webhook (POST /events). Empty = signatures NOT enforced (dev only).
Assistant__Webhook__Secret=
# Optional: secret for a co-located trusted relay (e.g. kgsm-api). Leave empty to disable that path.
Assistant__Relay__Secret=

# ── CORS — the SPA origin(s) allowed to call the API (array → indexed env keys) ──
Auth__AllowedOrigins__0=https://panel.example.com
# Auth__AllowedOrigins__1=https://staging.panel.example.com

# ── Web search (Tavily) — optional. Empty key = web search disabled, tool omitted. SECRET. ──
WebSearch__ApiKey=
WebSearch__MaxCallsPerDay=200

# ── Local RAG retrieval — optional. Point IndexPath at the file the indexer writes. ─────────
Rag__Enabled=false
Rag__IndexPath=/var/lib/kgsm-assistant/rag-index.krag
Rag__EmbeddingModel=embeddinggemma
Rag__Endpoint=http://localhost:11434

# ── Logging (optional) ──────────────────────────────────────────────────────
# Logging__LogLevel__Default=Information
