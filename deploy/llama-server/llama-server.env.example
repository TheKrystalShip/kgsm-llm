# llama.cpp serving the assistant's models. Copy to /etc/kgsm-assistant/llama-server.env.
#
# Only read by the two kgsm-llama-* units. The assistant itself is pointed at them through its own
# configuration (Llm:Provider / Llm:Endpoint and Rag:Provider / Rag:Endpoint), which lives in
# /etc/kgsm-assistant/service.env — the two files are set together and neither implies the other.

# The binary is NOT set here: systemd cannot expand a variable in a unit's executable position.
# install.sh writes the path it found into ExecStart instead.

# ── Chat model ───────────────────────────────────────────────────────────────
# The GGUF the assistant talks to. It has to carry a tools-capable chat template, or the unit's
# --jinja has nothing to work with and no tool is ever called.
LLAMA_CHAT_MODEL=/var/lib/llama/models/gemma4-12b-q4_k_m.gguf
# The vision projector that ships beside it. Without one the model is text-only.
LLAMA_CHAT_MMPROJ=/var/lib/llama/models/gemma4-12b-mmproj.gguf
# Must equal Llm:ContextWindow. The server fixes it here and a request cannot change it.
LLAMA_CHAT_CTX=32768
LLAMA_CHAT_PORT=8081
# The multi-token-prediction draft head, when the model ships one. Unused until the unit's
# ExecStart is given --spec-type draft-mtp --model-draft.
LLAMA_CHAT_DRAFT=/var/lib/llama/models/gemma4-12b-mtp.gguf

# ── Embedding model ──────────────────────────────────────────────────────────
# Changing this model invalidates an existing RAG index — a different embedder is a different
# vector space, and the index is rejected on load rather than silently answering from it.
LLAMA_EMBED_MODEL=/var/lib/llama/models/embeddinggemma-q8_0.gguf
# Bounds one chunk, not a conversation.
LLAMA_EMBED_CTX=2048
LLAMA_EMBED_PORT=8082

# ── Multi-token prediction (optional) ────────────────────────────────────────
# A draft head proposes several tokens and the 12B verifies them in one pass. Output is identical
# to generating without it; only the speed changes, and only in proportion to how predictable the
# text is. Measured on this card (RTX 3060, gemma4-12B Q4_K_M, Q8_0 head):
#
#   workload                       no MTP    MTP    draft acceptance
#   one-line answer               38.2      37.2    0.38   (slightly SLOWER — draft cost unamortised)
#   a few paragraphs of prose     38.1      42-45   0.46
#   reproducing a config block    37.9      65-70   0.92   (~1.8x)
#
# So it pays on structured output — which is what write_file and tool arguments are — and costs a
# little on short chat turns. 582 MiB of VRAM, measured per-process.
#
# llama-server reads these itself, so this is opt-in from here with no change to the unit. Both must
# be set; a path pointing at a missing file stops the server from starting, which is why they ship
# commented out. Draft KV quantization reclaims no memory (the cost is the head's weights, not its
# cache) but measured marginally faster, so it is set alongside.
#LLAMA_ARG_SPEC_TYPE=draft-mtp
#LLAMA_ARG_SPEC_DRAFT_MODEL=/var/lib/llama/models/mtp-gemma-4-12b-q8_0.gguf
#LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_K=q8_0
#LLAMA_ARG_SPEC_DRAFT_CACHE_TYPE_V=q8_0
