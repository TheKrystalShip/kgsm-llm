<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Kgsm.Assistant.Service</RootNamespace>
    <AssemblyName>TheKrystalShip.Kgsm.Assistant.Service</AssemblyName>
    <!-- This box ships the ASP.NET Core shared framework only at 10.x; the app targets
         net9.0, so roll forward to the installed major at runtime. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Let the test project reach the internal adapters / security helpers. -->
    <InternalsVisibleTo Include="TheKrystalShip.Kgsm.Assistant.Service.Tests" />
    <!-- Let NSubstitute (Castle DynamicProxy) mock the internal IDiscordOAuthClient. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reusable agent loop + the kgsm assistant (prompt, tools, dispatcher,
         policy, ConfirmAsync). The assistant stays KGSM.Lib-free; the KGSM.Lib glue
         that satisfies its ports lives in this service. -->
    <ProjectReference Include="..\TheKrystalShip.Llm\TheKrystalShip.Llm.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant\TheKrystalShip.Kgsm.Assistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev loop: consume the local kgsm-lib checkout (the canonical dev source)
         rather than the stale NuGet 1.1.0 — the Service needs the local lib's
         Reading<T> bulk-status shape (Phase 0) and is otherwise stranded across
         the 1.3.0 breaking release. Release-time packaging is a separate, later
         decision (no publish pipeline exists yet). -->
    <ProjectReference Include="..\..\kgsm-lib\kgsm-lib\kgsm-lib.csproj" />
  </ItemGroup>

</Project>
