<Project>

  <!-- Repo-wide scoped NuGet-audit suppression (NOT a blanket NuGetAudit=off). GHSA-2m69-gcr7-jv3q is an
       advisory on the native SQLite lib (SQLitePCLRaw.lib.e_sqlite3 2.1.11) pulled transitively by
       Microsoft.Data.Sqlite — TheKrystalShip.Llm's SqliteConversationStore (durable conversation memory).
       2.1.11 is the latest published build of that native lib, so there is no fixed version to move to yet.
       Every project that references the assistant lib audits it transitively, so the suppression lives here
       (one place) rather than in each csproj. Exposure is minimal: SQLite stores only this host's local
       conversation memory on a trusted single host (no untrusted SQL, no network DB). Mirrors kgsm-api's
       same-advisory suppression — DELETE the moment a patched SQLitePCLRaw bundle ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
