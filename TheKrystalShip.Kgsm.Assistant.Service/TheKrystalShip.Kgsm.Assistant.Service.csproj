<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Kgsm.Assistant.Service</RootNamespace>
    <AssemblyName>kgsm-assistant</AssemblyName>
    <!-- This repo's release line — the version CHANGELOG.md tracks and the one the assistant package
         ships under. The three published libraries (TheKrystalShip.Llm, .Kgsm.Assistant and
         .Kgsm.Assistant.Relay) each version independently of it and of each other. Read by
         deploy/version.sh, which is the single source for packaging. -->
    <Version>1.31.0</Version>
    <!-- Forward-compat insurance: roll a framework-dependent run forward to a newer installed
         major if this box ever lacks the net10 ASP.NET Core shared framework. -->
    <RollForward>LatestMajor</RollForward>

    <!-- Framework-dependent single-file deploy (the host has the net10 ASP.NET Core shared
         runtime). Publish-only props; the RID is supplied at publish time (deploy/deploy.sh). -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!-- The leaf config descriptor is generated from the settings types in this project and in the
         assemblies it names in LeafDescriptor.cs. -->
    <LeafSettingsFile>kgsm-assistant.settings.json</LeafSettingsFile>
    <LeafDescriptorFile>$(MSBuildProjectDirectory)/../deploy/kgsm-llm.leaf.json</LeafDescriptorFile>

    <!-- The command manifest the Control Panel lists this leaf's commands from. Named for the repo
         beside the leaf descriptor; deploy.sh installs it under the leaf id the file declares. -->
    <AssistantCommandManifestFile>$(MSBuildProjectDirectory)/../deploy/kgsm-llm.commands.json</AssistantCommandManifestFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
    <PackageReference Include="TheKrystalShip.KGSM.Auth" Version="3.0.0" />
    <PackageReference Include="TheKrystalShip.KGSM.Auth.Discord" Version="4.0.0" />
    <PackageReference Include="TheKrystalShip.KGSM.Auth.Sessions" Version="2.0.0" />
    <!-- The host's KGSM accounts, read straight off the shared store. Not via kgsm-api: a file is
         not something a sibling service can be down for, which is what keeps this leaf standalone. -->
    <PackageReference Include="TheKrystalShip.KGSM.Auth.Users" Version="1.2.0" />
    <!-- RFC 8291/8292 only: the encryption and the VAPID token, with no opinion about what is being
         announced or to whom. The subscriptions, the preferences and the staged actions are this
         leaf's own — sharing those with kgsm-api would be sharing an audience, not a protocol. -->
    <PackageReference Include="TheKrystalShip.KGSM.WebPush" Version="1.0.0" />

    <!-- The host's speech engine (kgsm-speech), for reading an answer aloud as it is written. An
         OPTIONAL leaf: this is the client and the wire contract, a few kilobytes with no native
         dependency, and an assistant on a host without that leaf simply never emits an audio frame. -->
    <PackageReference Include="TheKrystalShip.KGSM.Speech" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings file ships beside the binary and Program.cs loads it by absolute path. The SDK
         already globs it into Content, so this only adds the copy-to-output the SDK gives by name to
         "appsettings.json" alone — without it the file publishes but is absent from a local run. -->
    <Content Update="kgsm-assistant.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="kgsm-assistant.settings.*.json">
      <DependentUpon>kgsm-assistant.settings.json</DependentUpon>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Let the test project reach the internal adapters / security helpers. -->
    <InternalsVisibleTo Include="TheKrystalShip.Kgsm.Assistant.Service.Tests" />
    <!-- Let NSubstitute (Castle DynamicProxy) mock the internal security types. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reusable agent loop + the kgsm assistant (prompt, tools, dispatcher,
         policy, ConfirmAsync). The assistant stays KGSM.Lib-free; the KGSM.Lib glue
         that satisfies its ports now lives in the shared Infrastructure library
         (AddKgsmAdapters), which this service and the CLI both sit on. -->
    <ProjectReference Include="..\TheKrystalShip.Llm\TheKrystalShip.Llm.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant\TheKrystalShip.Kgsm.Assistant.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant.Relay\TheKrystalShip.Kgsm.Assistant.Relay.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant.Infrastructure\TheKrystalShip.Kgsm.Assistant.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Write the command manifest by running the binary that was just built, so the shipped file is
       generated from this build's own ChatCommands catalog rather than a list someone maintains
       beside it. Same reason the leaf descriptor is generated — and, like it, the result is
       committed. Inputs/Outputs keep it off no-op builds; a design-time build never runs it. -->
  <Target Name="EmitAssistantCommandManifest" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(TargetPath)" Outputs="$(AssistantCommandManifestFile)">
    <Exec Command="dotnet exec &quot;$(TargetPath)&quot; --emit-commands &quot;$(AssistantCommandManifestFile)&quot;"
          StandardOutputImportance="low" />
    <Message Importance="normal" Text="kgsm-assistant command manifest → $(AssistantCommandManifestFile)" />
  </Target>

</Project>
