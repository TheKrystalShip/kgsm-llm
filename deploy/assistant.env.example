# ─────────────────────────────────────────────────────────────────────────────
# KGSM Assistant Service — environment file (systemd EnvironmentFile)
#
# Copy to /etc/kgsm-assistant/service.env, fill in the real values, then:
#     sudo chmod 600 /etc/kgsm-assistant/service.env
#     sudo chown kgsm:kgsm /etc/kgsm-assistant/service.env
#
# This file holds SECRETS. They are intentionally NOT in the settings file — supply them
# only via the environment. Every key uses the ASP.NET "Section__Key" double-underscore form
# and overrides the matching kgsm-assistant.settings.json value. A variable naming a key that file
# does not declare binds to nothing. Full reference: ../docs/CONFIGURATION.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Listen address (loopback; TLS terminates at the reverse proxy in front) ──
ASPNETCORE_URLS=http://127.0.0.1:5180

# ── Backends ──────────────────────────────────────────────────────────────
# Ollama (chat model). Embedder endpoint is Rag__Endpoint, below.
Ollama__Endpoint=http://localhost:11434
Ollama__Model=gemma4:12b
# Absolute path to the kgsm engine entrypoint this host manages. /usr/bin, never /usr/local — that
# is the local administrator's, and the kgsm package puts its entry point here.
KGSM__Path=/usr/bin/kgsm
# The engine's append-only event journal, which this service reads so a blueprint edited elsewhere
# drops its cache here at once instead of going stale until the TTL expires. Read-only and shared:
# the engine is the sole writer and every consumer reads the same files, so nothing needs
# configuring on the engine side. The unit sets it already; override only to move the journal.
# KGSM__JournalDir=/var/lib/kgsm/events

# The directory holding the assistant's prompt segments and tool definitions. They are files, not
# code — the service refuses to start without them, naming what is missing. The unit already points
# at the directory this host's install laid them down in; set this only to run the service on a
# hand-edited copy somewhere else.
# Prompts__Directory=/etc/kgsm-assistant/prompts
# ── Discord sign-in (this surface's own endpoints) ──────────────────────────
# The application credentials, the guild, the bot token and the role→tier map are the
# ECOSYSTEM's, shared with the Control Panel API and the Discord bot: setup.sh seeds them in
# /etc/kgsm/kgsm-auth.env, which this unit loads BEFORE this file. Setting a KgsmAuth__* key
# here overrides the shared value for this leaf alone — which is how a host ends up with one
# surface answering "who may stop a server" differently from another. Do it deliberately or not
# at all.
#
# What stays here is this surface's own callback. It must exactly match a redirect URI registered
# on the Discord application, and it points at THIS service's sign-in landing — not at any SPA.
# It names THIS host's public address, so it is commented: a live value here would describe some
# other machine on every host seeded from this file.
# DiscordOAuth__RedirectUri=https://assistant.example.com/auth/discord/callback

# ── Sessions ────────────────────────────────────────────────────────────────
# The key sign-in tokens are signed with. Generate ONCE:
#     openssl rand -base64 48
# It must NOT change between restarts: unset means a fresh per-process key, so every sign-in dies
# with the service. A STABLE key is what makes "come back next week, still signed in" work.
Auth__SigningKey=

# ── Action authority + confirmation signing ─────────────────────────────────
# Master switch for mutating actions. Leave false until Discord auth is wired and tested.
Assistant__ActionsEnabled=true
# Shared secret for the kgsm event webhook (POST /events). Commented, so signatures are not
# enforced — set it on any host whose event endpoint is reachable from off the machine.
# Assistant__Webhook__Secret=
# Secret for a co-located trusted relay (e.g. kgsm-api). Commented, so that path is off; set it on
# both sides to turn it on.
# Assistant__Relay__Secret=

# ── CORS — the SPA origin(s) allowed to call the API (array → indexed env keys) ──
# Each entry is an origin a browser reaches this host from, so both are commented — no origin is
# true on more than the host it names. With none set, only a same-origin caller is allowed.
# Auth__AllowedOrigins__0=https://panel.example.com
# Auth__AllowedOrigins__1=https://staging.panel.example.com

# ── Knowledge search (the `search` tool) ────────────────────────────────────
# The assistant's `search` tool is offered to the model IFF at least one source below backs it:
# local RAG docs (Rag__Enabled) and/or the Tavily web fallback (WebSearch__ApiKey). With BOTH off
# the tool is omitted entirely — that is the "no search tool" state. Keep at least one wired.
#
# Web search (Tavily) — the web fallback. SECRET; fill at deploy (https://tavily.com → API key,
# starts "tvly-"). Commented, so the web fallback is off and `search` answers from the local RAG
# corpus alone. Get a key per host or reuse one across hosts.
# WebSearch__ApiKey=
WebSearch__MaxCallsPerDay=200

# Local RAG retrieval — the operator's own indexed docs, searched FIRST (web is the fallback).
# ON by default. To actually serve hits it needs: (1) the indexer running — deploy with
# `./deploy/deploy.sh --with-indexer` on a host with Ollama, which builds + watches the index at
# IndexPath; (2) the embedder model pulled: `ollama pull embeddinggemma`. Until the index exists
# the tool degrades gracefully (no local hits, falls back to web) — it never errors. Set to false
# to disable local search on a host that won't run the indexer (then Tavily alone backs `search`).
Rag__Enabled=true
Rag__IndexPath=/var/lib/kgsm-assistant/rag-index.krag
Rag__EmbeddingModel=embeddinggemma
Rag__Endpoint=http://localhost:11434

# ── Logging (optional) ──────────────────────────────────────────────────────
# Logging__LogLevel__Default=Information
