{
  // === KGSM assistant service — configuration ===
  //
  // This file declares the service's WHOLE configurable surface, each key with its default. It is
  // the floor; an environment variable overrides one key of it by spelling that key's path with
  // "__" — Llm__Model, Rag__Enabled, Logging__LogLevel__Default. A variable naming a key that is
  // not declared here binds to nothing.
  //
  // Every key maps onto a property of the options class the service binds that section into, and a
  // test fails the build if the two ever disagree, in either direction, or if the leaf descriptor
  // (deploy/kgsm-llm.leaf.json — what the Control Panel renders) drifts from either.
  //
  // SECRETS ARE DECLARED HERE, NEVER SET HERE. The confirmation key, the webhook and relay secrets,
  // the Discord credentials and the web-search key are declared blank so the Control Panel can see
  // they exist; their real values belong in the root-owned /etc/kgsm-assistant/service.env, which is
  // not in version control.
  "Urls": "http://localhost:5180",
  // Which local server runs the model, and how it is asked. "Provider" is the only key that decides
  // WHICH server; every other key here means the same thing to both. On LlamaCpp the context window
  // is fixed when llama-server starts (-c) and this value has to match it — it is what token counts
  // are measured against, not something a request can change.
  "Llm": {
    "Provider": "LlamaCpp",
    "Endpoint": "http://127.0.0.1:8081",
    "Model": "gemma4:12b",
    "ContextWindow": 32768,
    "TimeoutSeconds": 300,
    "Temperature": 0.3,
    "Seed": null,
    "Think": false,
    // Only read when Provider is LlamaCpp. The API key is declared blank: a llama-server on loopback
    // is started without one, and a host that does start one puts the value in service.env.
    "LlamaCpp": {
      "ApiKey": "",
      "ParallelToolCalls": false,
      "ThinkingTemplateKwarg": "enable_thinking"
    }
  },
  // Reading an answer aloud, for a surface that asks to hear one. The models are NOT this leaf's:
  // kgsm-speech holds them — one engine per host, serving every surface, with the voice set there —
  // so all that lives here is whether to ask it for anything. A sentence is synthesised as soon as it
  // is written, which is what lets the first one play before the answer is finished. A host with no
  // speech leaf ignores all of this and answers in text.
  "Speech": {
    "Enabled": true,
    // Blank uses the standard socket path the engine listens on.
    "SocketPath": ""
  },

  "Conversation": {
    "DatabasePath": "/var/lib/kgsm-assistant/conversations.db",

    // How full the context window may get before a finished turn is summarised into a checkpoint on
    // its own. 0 leaves compaction entirely manual, which in practice means it never happens: a
    // conversation nobody compacts grows until the backend drops the front of it, and the first sign
    // is the assistant having forgotten something nobody asked it to forget. A room shared by a
    // Discord channel makes that a certainty — it is one conversation for the life of the place.
    // Well under 100 on purpose: the trigger is measured on the turn that just ran, and the next one
    // still needs room for a fresh system prompt, the injected server lists and its tool output.
    "CompactAtPercent": 70
  },
  "KGSM": {
    "Path": "/usr/local/bin/kgsm",
    // Blank is the OFF switch, not a missing value: the engine event listener is opt-in and does
    // not start without a directory here. The unit sets one on a resident host; a one-shot surface
    // has no use for a journal reader.
    "JournalDir": ""
  },

  // The leaves this service reads through. Each is optional: an absent or unreachable socket makes
  // the matching answer honestly unavailable rather than failing the turn.
  "Monitor": {
    "SocketPath": "/run/kgsm-monitor/metrics.sock"
  },
  "Watchdog": {
    "SocketPath": "/run/kgsm-watchdog/control.sock"
  },
  "Firewall": {
    "SocketPath": "/run/kgsm-firewall/firewall.sock"
  },
  "LlmAgent": {
    "MaxIterations": 25,
    "MaxToolOutputChars": 1500,
    "IterationLimitReply": "I wasn't able to finish that after a few steps — could you rephrase or break it down?"
  },
  "InventoryCache": {
    "InstancesTtlSeconds": 300,
    "BlueprintsTtlSeconds": 600
  },

  // A directory of editable prompt files that override the assistant's built-in system prompt and
  // tool descriptions, read straight from configuration by the assistant library. Blank leaves the
  // library's own text in force, which is the host-agnostic default every surface shares.
  "Prompts": {
    "Directory": ""
  },

  // Actions are OFF until switched on. A proposed action is held server-side and a client is given
  // only a handle to approve it with, so it survives a restart and needs no secret of its own.
  "Assistant": {
    "ActionsEnabled": false,
    "Confirmation": {
      "TtlSeconds": 300
    },
    "Webhook": {
      "Secret": ""
    },
    "Relay": {
      "Secret": ""
    },
    "Push": {
      "Enabled": true,
      "Subject": "https://github.com/TheKrystalShip/KGSM",
      "PresenceGraceSeconds": 20,
      "PollSeconds": 5
    }
  },
  "KgsmAuth": {
    "Providers": {
      "discord": {
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },
  "DiscordOAuth": {
    "RedirectUri": "",
    "Scopes": "identify"
  },
  "Auth": {
    // The HMAC secret session tokens are signed with. Environment-only, like every other secret;
    // unset means an ephemeral per-process key and everyone signed out on restart.
    "SigningKey": "",
    // The token audience. Empty means this machine's name — a settings file cannot know the host
    // it will be installed on.
    "HostId": "",
    // The host's shared KGSM account store. Every KGSM service on this host reads the same file, so
    // one person is one account whichever surface they sign in to.
    "UsersDbPath": "/var/lib/kgsm/auth/users.db",
    "AccessTtlSeconds": 900,
    "SessionTtlSeconds": 2592000,
    "RoleCacheTtlSeconds": 5,
    // How many people can be awaiting approval at once, and how long an unattended request survives.
    "PendingUserCap": 32,
    "PendingUserTtlDays": 14,
    "StateTtlSeconds": 300,
    "AllowedOrigins": []
  },
  "WebSearch": {
    "ApiKey": "",
    "MaxResults": 4,
    "SearchDepth": "basic",
    "TimeoutSeconds": 10,
    "MaxCallsPerDay": 200
  },
  "WebFetch": {
    "Enabled": false,
    "TimeoutSeconds": 8,
    "MaxContentBytes": 3145728,
    "MaxRedirects": 5,
    "MaxCallsPerDay": 200,
    "AllowedHosts": [],
    "DeniedHosts": []
  },
  "BlueprintAuthoring": {
    "Enabled": false,
    "StashDir": "",
    "MaxAttempts": 3,
    "VerifyTimeoutSeconds": 240,
    "VerifyPollIntervalSeconds": 5
  },

  // The local knowledge base. The index is written by kgsm-rag-indexer and read here; a mismatched
  // embedding model is rejected on load rather than silently answering from a different vector space.
  "Rag": {
    "Enabled": false,
    "IndexPath": "",
    "TopK": 5,
    "MinScore": 0.0,
    "LocalMinScore": 0.50,
    "MaxContextChars": 6000,
    "EmbeddingModel": "embeddinggemma",
    // Chosen independently of the chat model's server: the index is its own model, and may be
    // served from somewhere else entirely.
    "Provider": "LlamaCpp",
    "Endpoint": "http://127.0.0.1:8082",
    "TimeoutSeconds": 120,
    "Sources": [],
    "SourcePattern": "*.md",
    "ChunkSize": 2000,
    "ChunkOverlap": 200,
    // null, NOT "": null resolves the task prefix from the embedding model's name, while an empty
    // string is a real prefix meaning "none at all", which measurably hurts retrieval.
    "DocumentPrefix": null,
    "QueryPrefix": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TheKrystalShip": "Debug"
    }
  }
}
