<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Rag.Indexer</RootNamespace>
    <!-- The binary is `kgsm-rag-indexer`, not the dotted project name. -->
    <AssemblyName>kgsm-rag-indexer</AssemblyName>
    <!-- The whole point of decoupling the indexer (D6/D10): a standalone Native-AOT binary with
         low idle RSS and no JIT warmup. The core is already AOT-safe; this exe triggers the full
         ILC pass — expect 0 IL2026/IL3050/ILC warnings. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AOT-safe core: embed client (source-gen JSON) + chunker + versioned index + the
         Phase 3a indexing engine. No kgsm-lib / TheKrystalShip.Llm / Infrastructure deps. -->
    <ProjectReference Include="..\TheKrystalShip.Rag\TheKrystalShip.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stderr logging (the ecosystem convention for an interactive one-shot). Brings
         Microsoft.Extensions.Logging transitively. ILC-clean (same provider the AOT
         watchdog/monitor use). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheKrystalShip.Rag.Indexer.Tests" />
  </ItemGroup>

</Project>
