<Project>

  <!-- Repo-wide scoped NuGet-audit suppression (NOT a blanket NuGetAudit=off). GHSA-2m69-gcr7-jv3q is an
       advisory on the native SQLite lib (SQLitePCLRaw.lib.e_sqlite3 2.1.11) pulled transitively by
       Microsoft.Data.Sqlite — TheKrystalShip.Llm's SqliteConversationStore (durable conversation memory).
       2.1.11 is the latest published build of that native lib, so there is no fixed version to move to yet.
       Every project that references the assistant lib audits it transitively, so the suppression lives here
       (one place) rather than in each csproj. Exposure is minimal: SQLite stores only this host's local
       conversation memory on a trusted single host (no untrusted SQL, no network DB). Mirrors kgsm-api's
       same-advisory suppression — DELETE the moment a patched SQLitePCLRaw bundle ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- Every test project in this repo runs inside a temp directory of its own, so a run takes back
       the databases, indexes and state files its fixtures wrote. One source, compiled into each test
       assembly, because the type is internal and does not cross an assembly boundary. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <Compile Include="$(MSBuildThisFileDirectory)TestTempRoot.cs" Link="TestTempRoot.cs" />
  </ItemGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardErrorImportance="low" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitExitCode)' == '0' and '$(_GitShortSha)' != ''">
      <SourceRevisionId>$(_GitShortSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
