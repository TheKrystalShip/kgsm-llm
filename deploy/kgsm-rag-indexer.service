[Unit]
# KGSM RAG indexer — watches the docs corpus and rebuilds the vector index on change.
# Native-AOT standalone binary (no .NET runtime needed). Full runbook: ../docs/DEPLOYMENT.md
Description=KGSM RAG indexer (watch mode)
Documentation=https://github.com/TheKrystalShip/kgsm-llm
# IMPORTANT: order AFTER whichever embedding server this host runs. The indexer embeds at startup;
# if the server is down when it boots, the initial build fails and there is NO periodic retry (the
# index stays stale until the next doc edit). Ordering is the fix for that startup gap.
#
# Both backends are listed and NEITHER is required. After= only orders units that are being started
# anyway, so a host running one of them gets the ordering and a host running the other is unaffected.
# A Requires= on a specific backend would be worse than useless here: it STARTS that backend, and on
# a llama.cpp host starting Ollama trips the Conflicts= on kgsm-llama-chat and takes the chat model
# down — rebuilding the index would silently switch the assistant's backend out from under it.
After=network-online.target ollama.service kgsm-llama-embed.service
Wants=network-online.target

[Service]
Type=simple
User=kgsm
Group=kgsm

# --watch builds once, then re-indexes (incrementally) on any change under --source until stopped.
# The --index file's DIRECTORY must share a filesystem with the index (atomic temp→rename swap),
# and must be the SAME path the Service reads via Rag:IndexPath.
#
# The corpus is kgsm's own knowledge base: the blueprint-authoring references and the per-game
# operator guides, which are what a person asks this assistant about. It is deliberately the ONLY
# source. Indexing the ecosystem's design and planning documents instead puts architecture prose
# in front of someone asking how to run a server, and a local hit suppresses the web fallback
# outright — so a wider corpus here makes answers worse, not better.
ExecStart=/opt/kgsm-assistant/indexer/kgsm-rag-indexer \
    --watch \
    --source /opt/kgsm/docs/knowledge \
    --index ${STATE_DIRECTORY}/rag-index.krag \
    --model embeddinggemma \
    --endpoint ${RAG_EMBED_ENDPOINT} \
    --provider ${RAG_EMBED_PROVIDER} \
    --debounce-ms 750
# Which embedding server to build against. The indexer holds no provider switch of its own — it is
# told, because Ollama and llama-server expose different routes and guessing produces a failed build.
# use-backend.sh rewrites this file when the backend moves; these are the fallbacks if it never has.
Environment=RAG_EMBED_ENDPOINT=http://127.0.0.1:8082
Environment=RAG_EMBED_PROVIDER=LlamaCpp
EnvironmentFile=-/etc/kgsm-assistant/rag-indexer.env

# Graceful stop: the daemon handles SIGTERM and exits 0, so on-failure won't respawn an intended stop.
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kgsm-rag-indexer

NoNewPrivileges=true
# /var/lib/kgsm-assistant, created before ExecStart owned by User= and exported as $STATE_DIRECTORY
# — which is where the --index argument above gets it from, so the path is declared once. It is also
# the only thing this daemon writes to: StateDirectory= makes it writable through ProtectSystem=strict
# below without naming it a second time. kgsm-assistant-service.service declares the SAME directory
# and reads the index written here; both units run as the same user.
StateDirectory=kgsm-assistant
StateDirectoryMode=0750
ProtectSystem=strict
# The corpus lives under /opt, so the daemon never needs a home directory.
ProtectHome=true

[Install]
WantedBy=multi-user.target
