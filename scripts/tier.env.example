# ─────────────────────────────────────────────────────────────────────────────
#  tier.env — local config for scripts/verify-tiers.sh
#
#  Copy this to `scripts/tier.env` (gitignored) and fill in the values from your
#  Discord Developer Portal + Discord client. verify-tiers.sh sources this file
#  automatically; anything you leave blank it will prompt for at runtime.
#
#  THE CLIENT SECRET:
#    Leaving DiscordOAuth__ClientSecret blank here is the recommended path — the
#    script will read it from your environment if already exported, otherwise
#    prompt for it silently (never echoed, never written to disk, never passed as
#    a process arg). If you DO put it in this file, the file is gitignored and the
#    script chmod 600's it — but exporting/prompting keeps the secret off disk.
# ─────────────────────────────────────────────────────────────────────────────

# --- Discord OAuth (Developer Portal → your existing bot application) ---------
# OAuth2 → Client ID (this is the bot application id):
export DiscordOAuth__ClientId=""
# OAuth2 → reset & copy the Client Secret. Prefer leaving blank (see note above):
export DiscordOAuth__ClientSecret=""
# Discord client (Developer Mode on) → right-click the SERVER icon → Copy Server ID:
export DiscordOAuth__GuildId=""
# Server Settings → Roles → right-click the ACTION role → Copy Role ID.
# Use the same role the bot's ActionRoleId points at. Leave blank to test
# read-only only (canPerformActions will be false; the destructive path is skipped):
export DiscordOAuth__ActionRoleId=""
# Must EXACTLY match a redirect registered in OAuth2 → Redirects.
# For Tier-1 (local, no tunnel) register and use this one:
export DiscordOAuth__RedirectUri="http://localhost:5180/health"

# --- Tier-2 (CORS preflight only; the rest of Tier-2 is a manual checklist) ----
# The SPA origin the service will allow cross-origin. The exact value doesn't
# matter for proving CORS echoes an allowed origin; set your real github.io
# origin here when you have it. Defaults to a sample if left blank.
export TIER2_ORIGIN="https://example.github.io"

# --- Optional overrides --------------------------------------------------------
# export BASE_URL="http://localhost:5180"   # where the service listens
# export SSE_TIMEOUT="120"                   # max seconds to wait on an SSE turn
