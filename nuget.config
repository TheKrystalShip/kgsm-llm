<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds the local folder feed where TheKrystalShip.KGSM.Lib is packed during
    development (/home/heisen/local-nuget). Merged with the global sources
    (nuget.org, github), so their credentials are preserved. This is how the
    assistant resolves kgsm-lib as a package — the same PackageReference pattern
    every other .NET consumer (kgsm-watchdog / kgsm-api / kgsm-monitor) uses.
    Once TheKrystalShip.KGSM.Lib is published to the github/nuget.org feed this
    local source can be removed.
  -->
  <packageSources>
    <add key="local-thekrystalship" value="/home/heisen/local-nuget" />
  </packageSources>
</configuration>
