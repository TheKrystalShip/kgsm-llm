<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Kgsm.Assistant.Eval</RootNamespace>
    <!-- The benchmark runner; the binary is kgsm-assistant-eval. -->
    <AssemblyName>kgsm-assistant-eval</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same backend the CLI drives — the harness runs the real assistant in-process so
         the trajectory it scores is the one a user would get. Never references the API/Service. -->
    <ProjectReference Include="..\TheKrystalShip.Llm\TheKrystalShip.Llm.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant\TheKrystalShip.Kgsm.Assistant.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant.Infrastructure\TheKrystalShip.Kgsm.Assistant.Infrastructure.csproj" />
    <!-- The Native-AOT RAG core: the MCQ mode (Phase 5) builds an index in-process and queries it
         directly, so it composes the core's embed client + chunker + cosine search, not just the
         assistant's adapter over them. AOT-safe code runs fine under the eval's JIT. -->
    <ProjectReference Include="..\TheKrystalShip.Rag\TheKrystalShip.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The eval's own config defaults (Ollama endpoint, recording off); copied next to the binary
         and read at startup. Operator-specific values (KGSM:Path, model) come from the CLI config,
         env, or flags — never baked here. -->
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The ground-truth MCQ corpus + its real-docs snapshot (Phase 5): copied next to the binary so
         the MCQ mode finds them by default. The snapshot is committed on purpose — a fixed baseline
         for run over run comparison; the docs are real ecosystem content the base model genuinely lacks. -->
    <None Include="mcq\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Let the test project exercise the (internal) checks, scoring, compare, and options parser. -->
    <InternalsVisibleTo Include="TheKrystalShip.Kgsm.Assistant.Eval.Tests" />
  </ItemGroup>

</Project>
