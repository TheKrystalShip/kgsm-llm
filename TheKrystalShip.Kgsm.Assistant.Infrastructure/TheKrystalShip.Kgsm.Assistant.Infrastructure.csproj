<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TheKrystalShip.Kgsm.Assistant.Infrastructure</RootNamespace>
    <AssemblyName>TheKrystalShip.Kgsm.Assistant.Infrastructure</AssemblyName>

    <!-- This project declares bound settings sections, so it compiles the descriptor attributes and
         emits the documentation file their <panel> tags travel in. It generates nothing itself — the
         Service owns that step and names this assembly. -->
    <GenerateLeafDescriptor>false</GenerateLeafDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both hosts' adapter tests reach the internal adapters (TavilyWebSearch,
         KgsmServerInventory/Operations). -->
    <InternalsVisibleTo Include="TheKrystalShip.Kgsm.Assistant.Infrastructure.Tests" />
  </ItemGroup>

  <!--
    Floor the framework-extension deps at 9.0.0. Unlike TheKrystalShip.Llm (which floors at
    8.0.0 and references nothing heavier), this lib hard-depends on kgsm-lib, which itself
    requires Microsoft.Extensions.* >= 9.0.0 — pinning 8.0.0 here is a package downgrade
    (NU1605). Microsoft.Extensions.Http supplies the typed-client AddHttpClient overload the
    Tavily registration uses; it is NOT part of the base shared framework, so it must be
    referenced explicitly (the Web SDK gave it to the Service transitively before this extraction).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- IHostedService only: the kgsm event listener binds its socket on host start. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assistant ports this lib satisfies (IServerInventory / IServerOperations /
         IWebSearch / IRetrieval) + the reusable Result type. -->
    <ProjectReference Include="..\TheKrystalShip.Llm\TheKrystalShip.Llm.csproj" />
    <ProjectReference Include="..\TheKrystalShip.Kgsm.Assistant\TheKrystalShip.Kgsm.Assistant.csproj" />
    <!-- The Native-AOT RAG core: embedding client + versioned index reader + cosine search that
         back the IRetrieval adapter. The index file itself is produced out-of-band by the
         standalone indexer (plan §D6); this lib only reads it. -->
    <ProjectReference Include="..\TheKrystalShip.Rag\TheKrystalShip.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single C#<->kgsm chokepoint, consumed as the packed NuGet from the local feed
         (nuget.config → /home/heisen/local-nuget), same pattern as kgsm-watchdog / kgsm-api /
         kgsm-monitor. Bump this version when a new kgsm-lib is packed. -->
    <PackageReference Include="TheKrystalShip.KGSM.Lib" Version="4.30.0" />
  </ItemGroup>

</Project>
