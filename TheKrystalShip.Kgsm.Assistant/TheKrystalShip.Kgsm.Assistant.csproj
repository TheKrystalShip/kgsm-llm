<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>TheKrystalShip.Kgsm.Assistant</PackageId>
    <Authors>Heisenberg</Authors>
    <Version>1.74.0</Version>
    <PackageProjectUrl>https://github.com/TheKrystalShip/TheKrystalShip.Llm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheKrystalShip/TheKrystalShip.Llm</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <Description>kgsm-specific assistant built on TheKrystalShip.Llm: system prompt, tool definitions, dispatcher, policy/caps, and confirmation staging. Host-agnostic via the IServerOperations / IServerInventory ports.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <RootNamespace>TheKrystalShip.Kgsm.Assistant</RootNamespace>
    <AssemblyName>TheKrystalShip.Kgsm.Assistant</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- This project declares bound settings sections, so it compiles the descriptor attributes and
         emits the documentation file their <panel> tags travel in. It generates nothing itself — the
         Service owns that step and names this assembly. -->
    <GenerateLeafDescriptor>false</GenerateLeafDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The chat-command catalog gates each command on the ecosystem's ordered tier, so every surface
         prints the same word that decides the answer. The package has zero dependencies and is
         AOT-safe, which is what lets the brain take it without reaching any consumer's footprint. -->
    <PackageReference Include="TheKrystalShip.KGSM.Auth" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheKrystalShip.Llm\TheKrystalShip.Llm.csproj" />
  </ItemGroup>

</Project>
